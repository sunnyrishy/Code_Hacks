LeetCode 448 — Find All Numbers Disappeared in an Array
LeetCode 442 — Find All Duplicates in an Array

⭐ Key Idea

Use the array itself as a frequency marker

For every value x, mark index x-1 as negative

Any index left positive was never visited

class Solution {
public:
    vector<int> findDisappearedNumbers(vector<int>& nums) {
        int n = nums.size();

        // Mark visited numbers
        for(int i = 0; i < n; i++){
            int idx = abs(nums[i]) - 1;
            if(nums[idx] > 0)
                nums[idx] = -nums[idx];
        }

        // Collect missing numbers
        vector<int> missing;
        for(int i = 0; i < n; i++){
            if(nums[i] > 0)
                missing.push_back(i + 1);
        }

        return missing;
    }
};
